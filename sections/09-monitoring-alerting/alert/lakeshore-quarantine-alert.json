{
  "display_name": "lakeshore-quarantine-alert",
  "query_text": "SELECT count(*) AS quarantined FROM lakeshore.silver.sdp_orders_quarantine",
  "warehouse_id": "__WAREHOUSE_ID__",
  "evaluation": {
    "source": { "name": "quarantined", "display": "quarantined" },
    "comparison_operator": "GREATER_THAN",
    "threshold": { "value": { "double_value": 10 } },
    "empty_result_state": "ERROR"
  },
  "schedule": {
    "quartz_cron_schedule": "0 0 7 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  }
}
